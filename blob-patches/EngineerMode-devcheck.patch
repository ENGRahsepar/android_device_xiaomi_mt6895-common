From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ENGRahsepar <alirahsepar199@gmail.com>
Date: Tue, 14 Oct 2026 14:10:00 +0330
Subject: [PATCH] EngineerMode: allow entry + survive missing EM HAL

1. Force mLastEnabledState=true (dev-options gate misreads on user builds).
2. Null-guard EmHIDL lookups: the engineermode HAL service does not
   exist on mt6895, getEmHidlService returns null and Elog.e(null)
   NPE-crashes EM on any IMS toggle. Log a constant and return false.
   Live-tested on xaga.

Change-Id: I0000000000000000000000000000000000000002
---
 smali_classes3/com/mediatek/engineermode/EmHalService.smali | 2 ++
 smali_classes3/com/mediatek/engineermode/EmUtils.smali      | 8 ++------
 smali_classes3/com/mediatek/engineermode/EngineerMode.smali | 2 ++
 3 files changed, 6 insertions(+), 6 deletions(-)
diff --git a/smali_classes3/com/mediatek/engineermode/EmHalService.smali b/smali_classes3/com/mediatek/engineermode/EmHalService.smali
--- a/smali_classes3/com/mediatek/engineermode/EmHalService.smali
+++ b/smali_classes3/com/mediatek/engineermode/EmHalService.smali
@@ -2868,6 +2868,8 @@
 
     move-result-object v1
 
+    if-eqz v1, :goto_0
+
     invoke-interface {v1, p0}, Lvendor/mediatek/hardware/engineermode/V1_3/IEmd;->setImsTestMode(Ljava/lang/String;)Z
 
     move-result v1
diff --git a/smali_classes3/com/mediatek/engineermode/EmUtils.smali b/smali_classes3/com/mediatek/engineermode/EmUtils.smali
--- a/smali_classes3/com/mediatek/engineermode/EmUtils.smali
+++ b/smali_classes3/com/mediatek/engineermode/EmUtils.smali
@@ -1083,9 +1083,7 @@
     invoke-static {v1, v2}, Lcom/mediatek/engineermode/Elog;->e(Ljava/lang/String;Ljava/lang/String;)V
 
     .line 187
-    invoke-virtual {v0}, Ljava/util/NoSuchElementException;->getMessage()Ljava/lang/String;
-
-    move-result-object v2
+    const-string v2, "EmHIDL service not found, skipping"
 
     invoke-static {v1, v2}, Lcom/mediatek/engineermode/Elog;->e(Ljava/lang/String;Ljava/lang/String;)V
 
@@ -1106,9 +1104,7 @@
     invoke-static {v1, v2}, Lcom/mediatek/engineermode/Elog;->e(Ljava/lang/String;Ljava/lang/String;)V
 
     .line 183
-    invoke-virtual {v0}, Landroid/os/RemoteException;->getMessage()Ljava/lang/String;
-
-    move-result-object v2
+    const-string v2, "EmHIDL service not found, skipping"
 
     invoke-static {v1, v2}, Lcom/mediatek/engineermode/Elog;->e(Ljava/lang/String;Ljava/lang/String;)V
 
diff --git a/smali_classes3/com/mediatek/engineermode/EngineerMode.smali b/smali_classes3/com/mediatek/engineermode/EngineerMode.smali
--- a/smali_classes3/com/mediatek/engineermode/EngineerMode.smali
+++ b/smali_classes3/com/mediatek/engineermode/EngineerMode.smali
@@ -650,6 +650,8 @@
 
     move-result v1
 
+    const/4 v1, 0x1
+
     if-eqz v1, :cond_2
 
     move v1, v0
